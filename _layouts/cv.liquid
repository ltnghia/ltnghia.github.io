---
layout: default
---
{% unless site.data.resume %}
  <div class="post">
    <header class="post-header">
      <h1 class="post-title">
        {{ page.title }}
        {% if page.cv_pdf %}
          <a
            {% if page.cv_pdf contains '://' %}
              href="{{ page.cv_pdf }}"
            {% else %}
              href="{{ page.cv_pdf | prepend: 'assets/pdf/' | relative_url }}"
            {% endif %}
            target="_blank"
            rel="noopener noreferrer"
            class="float-right"
          >
            <i class="fa-solid fa-file-pdf"></i>
          </a>
        {% endif %}
      </h1>
      {% if page.description %}
        <p class="post-description">{{ page.description }}</p>
      {% endif %}
    </header>

    <article>
      <div class="cv">
        {% for entry in site.data.cv %}
          <a class="anchor" id="{{ entry.title }}"></a>
          <div class="card mt-3 p-3">
            <h3 class="card-title font-weight-medium">{{ entry.title }}</h3>
            <div>
              {% if entry.type == 'list' %}
                {% include cv/list.liquid %}
              {% elsif entry.type == 'map' %}
                {% include cv/map.liquid %}
              {% elsif entry.type == 'nested_list' %}
                {% include cv/nested_list.liquid %}
              {% elsif entry.type == 'time_table' %}
                {% include cv/time_table.liquid %}
              {% elsif entry.type == 'list_groups' %}
                {% include cv/list_groups.liquid %}
              {% else %}
                {{ entry.contents }}
              {% endif %}
            </div>
          </div>
        {% endfor %}
      </div>
    </article>
  </div>
{% else %}
  <div class="post">
    <header class="post-header">
      <h1 class="post-title">
        {{ page.title }}
        {% if page.cv_pdf %}
          <a
            {% if page.cv_pdf contains '://' %}
              href="{{ page.cv_pdf }}"
            {% else %}
              href="{{ page.cv_pdf | prepend: 'assets/pdf/' | relative_url }}"
            {% endif %}
            target="_blank"
            rel="noopener noreferrer"
            class="float-right"
          >
            <i class="fa-solid fa-file-pdf"></i>
          </a>
        {% endif %}
      </h1>
      {% if page.description %}
        <p class="post-description">{{ page.description }}</p>
      {% endif %}
    </header>

    <article>
      <div class="cv">
        {%- if site.data.resume.basics -%}
          {% include resume/basics.liquid %}
        {%- endif -%}

        {%- assign section_data = site.data.resume.education -%}
        {%- if section_data and section_data.size > 0 -%}
          <a class="anchor" id="education-background"></a>
          <div class="card mt-3 p-3">
            <h3 class="card-title font-weight-medium">Education Background</h3>
            <div>{% include resume/education.liquid %}</div>
          </div>
        {%- endif -%}

        {%- assign section_data = site.data.resume.work -%}
        {%- if section_data and section_data.size > 0 -%}
          <a class="anchor" id="working-experience"></a>
          <div class="card mt-3 p-3">
            <h3 class="card-title font-weight-medium">Working Experience</h3>
            <div>{% include resume/work.liquid %}</div>
          </div>
        {%- endif -%}

        {%- assign section_data = site.data.resume.volunteer -%}
        {%- if section_data and section_data.size > 0 -%}
          <a class="anchor" id="professional-activities"></a>
          <div class="card mt-3 p-3">
            <h3 class="card-title font-weight-medium">Professional Activities</h3>
            <div>{% include resume/volunteer.liquid %}</div>
          </div>
        {%- endif -%}

        {%- assign section_data = site.data.resume.grants -%}
        {%- if section_data and section_data.size > 0 -%}
          <a class="anchor" id="grant-and-fellowship"></a>
          <div class="card mt-3 p-3">
            <h3 class="card-title font-weight-medium">Grant and Fellowship</h3>
            <div>{% include resume/awards.liquid data=section_data %}</div>
          </div>
        {%- endif -%}

        {%- assign section_data = site.data.resume.awards -%}
        {%- if section_data and section_data.size > 0 -%}
          <a class="anchor" id="awards-and-honors"></a>
          <div class="card mt-3 p-3">
            <h3 class="card-title font-weight-medium">Awards and Honors</h3>
            <div>{% include resume/awards.liquid data=section_data %}</div>
          </div>
        {%- endif -%}

        {%- assign other_sections = "skills,languages,interests,certificates,projects,publications,references" | split: "," -%}
        {%- for section in other_sections -%}
          {%- assign section_data = site.data.resume[section] -%}
          {%- if section_data and section_data.size > 0 -%}
            <a class="anchor" id="{{ section }}"></a>
            <div class="card mt-3 p-3">
              <h3 class="card-title font-weight-medium">{{ section | capitalize }}</h3>
              <div>
                {%- case section -%}
                  {%- when 'projects' -%}{% include resume/projects.liquid %_}
                  {%- when 'skills' -%}{% include resume/skills.liquid %_}
                  {%- when 'publications' -%}{% include resume/publications.liquid %_}
                  {%- when 'languages' -%}{% include resume/languages.liquid %_}
                  {%- when 'interests' -%}{% include resume/interests.liquid %_}
                  {%- when 'certificates' -%}{% include resume/certificates.liquid %_}
                  {%- when 'references' -%}{% include resume/references.liquid %_}
                {%- endcase -%}
              </div>
            </div>
          {%- endif -%}
        {%- endfor -%}

      </div>
    </article>
  </div>
{% endunless %}